# Copy to .env and adjust. Dotenv loads .env automatically for test scripts.
#
# cp .env.example .env
#
# Required when the login screen appears (localhost server in Login_User.js):
# Connect_username=your@email
# Connect_password=yourpassword

# Running a single test: `node Tests/newMessage.js` — prints wall time via utils/cliTestTiming.js

# --- Suite speed / scope ---
# Skip resetToHome before tests 2+ in runAll (faster; tests must tolerate shared state).
# CONNECT_SKIP_RESET_BETWEEN_TESTS=1

# CreateRoom: smoke = public room only, skip private room block.
# CREATE_ROOM_MODE=smoke

# Markdown examples to run (comma-separated ids). Omit = all examples in markdowns.js.
# MARKDOWN_EXAMPLE_IDS=01_headings,02_emphasis,09_emojis
# Standalone markdown: poll for room name after login (no list scroll in markdowns).
# MARKDOWN_ROOM_WAIT_TIMEOUT_MS=30000
# MARKDOWN_ROOM_WAIT_INTERVAL_MS=600

# Markdown speed: skip per-example screenshots (keeps 01_room_opened); pair with CONNECT_SCREENSHOTS=0 for max savings.
# MARKDOWN_SKIP_EXAMPLE_SCREENSHOTS=1

# Composer waits (defaults in parentheses). Lower = faster, higher flake risk.
# MARKDOWN_COMPOSER_READY_TIMEOUT_MS=10000
# MARKDOWN_COMPOSER_READY_INTERVAL_MS=200
# MARKDOWN_COMPOSER_POST_READY_MS=120
# MARKDOWN_COMPOSER_FALLBACK_PAUSE_MS=500
# Typing pauses now default to 0 (no fixed delay); set only if your device needs extra settle.
# MARKDOWN_TYPE_PLACEHOLDER_PAUSE_MS=0
# MARKDOWN_TYPE_TEXTVIEW_PAUSE_MS=0

# ConversationList: layouts and sorts (comma-separated). Defaults are Classic,Cozy and three sorts.
# CONVERSATION_LAYOUTS=Classic
# CONVERSATION_SORTS=Recent Activity

# Max scroll attempts when finding labels in settings menus (default 10).
# CONVERSATION_SCROLL_MAX=12
# Pause ms between scroll steps in settings (default 260).
# CONVERSATION_SCROLL_PAUSE_MS=260
# Pauses after opening settings / after radio taps (defaults 450 / 350).
# CONVERSATION_MENU_OPEN_PAUSE_MS=450
# CONVERSATION_MENU_ACTION_PAUSE_MS=350

# --- newMessage / PinnedMessageEditFlow list scroll ---
# CONNECT_CONVERSATION_ENTRY_MAX_SCROLLS=24
# CONNECT_CONVERSATION_ENTRY_SCROLL_PAUSE_MS=250
# Wait only when the app explicitly reports lost connectivity.
# CONNECT_CONNECTION_RECOVERY_TIMEOUT_MS=120000

# --- Screenshots ---
# CONNECT_SCREENSHOTS=0
# Or: SKIP_SCREENSHOTS=1
# Add settle time before specific screenshots when the report catches a transition too early.
# Format: TestName/file.png=milliseconds,OtherTest/file.png=milliseconds
# SCREENSHOT_DELAYS_MS=CreateRoom/rooms_list_after_public.png=2000,attachments/05_attachment_in_composer.png=5000

# --- Parallel runner ---
# Run with: npm run test:parallel
# Default is conservative: one worker unless PARALLEL_UDIDS is set.
# PARALLEL_TESTS=newMessage,CreateRoom,PinnedMessageEditFlow
# PARALLEL_TESTS=all
# PARALLEL_WORKERS=2
# PARALLEL_DEVICE_NAMES=iPhone 17 Pro,iPhone 17 Pro Max
# PARALLEL_UDIDS=sim-udid-1,sim-udid-2
# PARALLEL_APPIUM_PORTS=4723,4725
# WDA_LOCAL_PORT=8100
# PARALLEL_RUN_ID=local-parallel
# PARALLEL_ALLOW_SHARED_DEVICE=0
# PARALLEL_DRY_RUN=1
# PARALLEL_LOGIN_ONCE_PER_WORKER=1
# Reuse one Appium session for all tests assigned to a one-worker lane.
# PARALLEL_REUSE_DRIVER=1
# Delay this lane's initial Appium session when several WDA sessions start together.
# PARALLEL_SESSION_START_DELAY_MS=0

# Split parallel shortcut (`npm run test:parallel:split`) writes a merged report here.
# SPLIT_COMBINED_RUN_ID=split-combined
# Split parallel defaults to one login and one reusable driver session per lane.
# SPLIT_LOGIN_ONCE_PER_LANE=1
# Optional diagnostic: create an extra session to verify login before the lane sessions start.
# SPLIT_LOGIN_PREFLIGHT=0
# Stagger the three WDA session requests by 0s/6s/12s to reduce Mac resource contention.
# Set to 0 only if the machine can reliably start all WDA sessions simultaneously.
# SPLIT_SESSION_STAGGER_MS=6000
# Run account-wide layout/sort coverage after concurrent feature lanes finish.
# SPLIT_EXCLUSIVE_SETTINGS=1
# Move safe ConversationView tests onto shorter physical lanes while preserving report category.
# SPLIT_BALANCE_CONVERSATION_VIEW=1
# SPLIT_BALANCED_CONVERSATION_VIEW_TESTS=PinnedMessageEditFlow,Reactions
# SPLIT_LIST_BALANCED_CONVERSATION_VIEW_TESTS=ComposerTypeahead,MessageActions,RoomNotificationPreferences
# Optional post-suite cleanup of generated A-/B-/M-/E- rooms.
# SPLIT_POST_RUN_CLEANUP=0
# SPLIT_POST_RUN_CLEANUP_STRICT=0
# SPLIT_POST_RUN_CLEANUP_LANE=main-suite
# Three-lane experiment: npm run test:parallel:split3
# SPLIT_THIRD_ENABLED=1
# SPLIT_THIRD_DEVICE_NAME=iPhone 17
# UDIDs are optional. The runner discovers distinct available simulators by device name.
# SPLIT_MAIN_UDID=your-main-simulator-udid
# SPLIT_STANDALONE_UDID=your-list-simulator-udid
# SPLIT_THIRD_UDID=your-conversation-view-simulator-udid
# SPLIT_THIRD_APPIUM_PORT=4727
# SPLIT_THIRD_WDA_PORT=8300
# SPLIT_THIRD_WDA_DERIVED_DATA_PATH=/tmp/wda-conversation-view
# Fresh simulator/CI preflight: install the app on every split lane before tests.
# SPLIT_INSTALL_APP=1
# CONNECT_APP_PATH=/path/to/Connect iOS.app
# Split runs verify the app is installed by default. Diagnostic override only:
# SPLIT_SKIP_APP_INSTALL_CHECK=0
# `npm run sims:ready` boots one lane and opens Connect before starting the next.
# Set this to 2 only on a machine with enough memory; 3 is not recommended.
# SIMULATOR_BOOT_CONCURRENCY=1
# Maximum time to wait for one simulator's iOS services to finish booting.
# SIMULATOR_BOOT_TIMEOUT_MS=90000
# Set 0 to only boot the simulators.
# SIMULATOR_BOOT_LAUNCH_APP=0
# SIMULATOR_BOOT_OPEN_UI=1
# Optional: wait/retry window for Connect after each simulator is booted.
# SIMULATOR_APP_LAUNCH_TIMEOUT_MS=45000
# SIMULATOR_APP_LAUNCH_RETRY_MS=1500

# --- Driver targeting ---
# DEVICE_NAME=iPhone 17 Pro
# SIMULATOR_UDID=booted
# APPIUM_PORT=4723
# WDA_LOCAL_PORT=8100
# WDA_DERIVED_DATA_PATH=/tmp/wda-connect-1
# APP_LAUNCH_SETTLE_MS=1500
# CONNECT_BUNDLE_ID=com.powerhrg.connect.v3.debug
# APPIUM_SHOW_XCODE_LOG=1
# APPIUM_USE_NEW_WDA=1
# Maximum cold-start wait for Connect to show login or the conversation list.
# Warm starts continue as soon as the UI appears; CI Macs may need 45000-60000.
# APP_ENTRY_TIMEOUT_MS=30000
# Attempt to dismiss a restored modal/setup flow after this many milliseconds.
# APP_ENTRY_RECOVERY_MS=4000
# APP_ENTRY_POLL_MS=250
# Fresh simulators can spend time hydrating the conversation list after login.
# LOGIN_SUCCESS_TIMEOUT_MS=60000
# LOGIN_POLL_MS=500

# --- User_Settings debug ---
# Opt in only when debugging settings screens; page source XML can be noisy and slow.
# USER_SETTINGS_DUMP_SOURCE=1

# --- favoriteRoom ---
# Dedicated list row to swipe (default "Favorite Room"). Waits / scrolls list until found.
# Optional existing fixture. Omit to create a unique A-Favorite room for each run.
# FAVORITE_ROOM_NAME=Favorite Room
# FAVORITE_ROOM_WAIT_TIMEOUT_MS=30000
# FAVORITE_ROOM_WAIT_INTERVAL_MS=400
# FAVORITE_ROOM_MAX_SCROLLS=12
# Hold + drag timing for coordinate swipe (default 120ms hold, 200ms move).
# FAVORITE_ROOM_SWIPE_HOLD_MS=120
# FAVORITE_ROOM_SWIPE_MOVE_MS=200
# Optional pauses after login / reset / scroll / swipe (ms; 0 = skip).
# FAVORITE_ROOM_POST_LOGIN_PAUSE_MS=400
# FAVORITE_ROOM_POST_RESET_PAUSE_MS=250
# FAVORITE_ROOM_POST_SCROLL_PAUSE_MS=200
# FAVORITE_ROOM_POST_SWIPE_PAUSE_MS=200

# --- markAsRead (standalone; mark unread / read via swipe right) ---
# By default the test creates its own M-MarkAsRead-* room. Set candidates only to target existing data.
# MARK_AS_READ_CANDIDATES=My Existing Room
# MARK_AS_READ_WAIT_TIMEOUT_MS=30000
# MARK_AS_READ_POLL_MS=400

# --- removeRoom (standalone; not in runAll yet) ---
# By default the test creates and removes its own E-RemoveRoom-* room.
# Set this only to intentionally remove an existing matching room.
# REMOVE_ROOM_CANDIDATES=My Existing Room
# REMOVE_ROOM_WAIT_TIMEOUT_MS=30000
# REMOVE_ROOM_POLL_MS=400

# --- removeAllrooms cleanup utility ---
# REMOVE_ALL_ROOMS_PREFIXES=A-,B-,M-,E-
# REMOVE_ALL_ROOMS_MAX_REMOVALS=200
# REMOVE_ALL_ROOMS_MAX_SCROLLS=80
# REMOVE_ALL_ROOMS_SCREENSHOTS=1

# --- New ConversationView tests ---
# These override the name of a newly created room; they do not open an existing room.
# Prefer the generated defaults for repeatable runs because fixed names can collide.
# COMPOSER_TYPEAHEAD_ROOM_NAME=A-Custom-Typeahead-Room
# MESSAGE_ACTIONS_ROOM_NAME=A-Custom-Message-Actions-Room
# MESSAGE_ACTIONS_MESSAGE=Unique message text
# ROOM_NOTIFICATION_TEST_LABEL=No notifications
# ROOM_NOTIFICATION_RESTORE_LABEL=Notify me for all messages
# ROOM_NOTIFICATION_ROOM_NAME=A-Custom-Notification-Room

# --- Opt-in system tests ---
# DraftPersistence app-state and composer timeout.
# SYSTEM_FLOW_TIMEOUT_MS=20000

# --- Selector source audit ---
# Defaults to the sibling checkout at ../connect-apple.
# CONNECT_APP_SOURCE=/Users/you/GitHub/connect-apple

# --- CreateRoom speed/debug ---
# CREATE_ROOM_SEND_MESSAGES=1

# --- Targets ---
# RECIPIENT=greg.blake
# Optional existing fixture. Omit to create a unique A-Markdown room for each run.
# MARKDOWN_ROOM_NAME=Message Room
# PINNED_EDIT_FLOW_ROOM_NAME=Message Room

# --- notifications (standalone; simctl push to simulator) ---
# CONNECT_BUNDLE_ID=com.powerhrg.connect.v3.debug
# SIMULATOR_UDID=booted
# NOTIFICATION_PAYLOAD_PATH=Tests/fixtures/connect-notification.apns
# NOTIFICATION_USE_ENV_PAYLOAD=1
# NOTIFICATION_TITLE=Connect
# NOTIFICATION_BODY=New message in Message Room
# NOTIFICATION_ROOM_ID=your-room-id
# NOTIFICATION_EVENT_TYPE=message
# NOTIFICATION_BADGE=1
# NOTIFICATION_SOUND=default
# NOTIFICATION_WAIT_TIMEOUT_MS=30000
# NOTIFICATION_BANNER_TIMEOUT_MS=6000
# Shared permission handling. On by default; set 0 if CI pre-grants permissions.
# IOS_NOTIFICATION_PERMISSION_CHECKS=1
# IOS_PHOTO_PERMISSION_CHECKS=1
# IOS_PERMISSION_PROMPT_TIMEOUT_MS=1500
# IOS_PHOTO_PERMISSION_PROMPT_TIMEOUT_MS=1500

# --- Scribe-style generated docs ---
# Builds Markdown docs from reports/runs and screenshots after a test run.
# SCRIBE_DOC_RUN_ID=split3-combined
# SCRIBE_DOC_OUTPUT_DIR=docs/generated/scribe
# Local report history is opt-in. Set 1 when you intentionally want timestamped archives.
# SCRIBE_ARCHIVE_ENABLED=0
# Optional Connect build metadata shown in the web report. Useful when the app build is from a different branch.
# TEST_REPORT_BRANCH=feature/my-branch
# TEST_REPORT_COMMIT=abc1234
# CONNECT_APP_VERSION=1.2.3
# CONNECT_APP_BUILD=456

# --- membersRoom (standalone; edit modal → Members → Edit flow) ---
# MEMBERS_ROOM_SORT_KEY=M
# MEMBERS_ROOM_TIMEOUT_MS=20000
# MEMBERS_ROOM_INVITEE=greg.blake
# MEMBERS_ROOM_REMOVE_MEMBER=   # optional; omit = first  on edit screen
# MEMBERS_ROOM_SEARCH_PAUSE_MS=800

# --- attachments (standalone; create public AttachmentRoom, in-room setup) ---
# ATTACHMENT_ROOM_SORT_KEY=A
# ATTACHMENT_ROOM_NAME=AttachmentRoom   # optional exact name; omit = A-AttachmentRoom-{rand}
# ATTACHMENT_ROOM_TIMEOUT_MS=20000
# ATTACHMENT_PHOTO_PICKER_TIMEOUT_MS=20000
# ATTACHMENT_PHOTO_MAX_SCROLLS=8
# ATTACHMENT_PHOTO_TAP_PAUSE_MS=200
# ATTACHMENT_PHOTO_MAX_ITEMS=9
# ATTACHMENT_COMPOSER_SETTLE_MS=5000
# ATTACHMENT_PHOTO_GRID_COLS=3
# ATTACHMENT_PHOTO_GRID_ROWS=2
# Fast photo selection taps first-row grid points immediately. Set 0 to use slower safety scan.
# ATTACHMENT_PHOTO_FAST_TAP=1
# ATTACHMENT_PHOTO_FAST_TAP_PAUSE_MS=80
# Backward-compatible attachment override for Photos permission checks.
# ATTACHMENT_PHOTO_PERMISSION_CHECKS=1
# GIF picker: after tapping Send GIF, tap the first visible GIF; the app auto-sends it.
# ATTACHMENT_GIF_PICKER_SETTLE_MS=800
# ATTACHMENT_GIF_SEND_SETTLE_MS=1500
# First GIF tile coordinate as a ratio of screen width/height.
# ATTACHMENT_GIF_TAP_X_RATIO=0.19
# ATTACHMENT_GIF_TAP_Y_RATIO=0.33
